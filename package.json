{
  "name": "frontend-packages",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit -p scripts",
    "test": "bun test ./scripts && bun run --filter '*' test",
    "test:packages": "bun scripts/check-example-packages.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  }
}
